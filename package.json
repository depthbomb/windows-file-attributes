{
	"name": "windows-file-attributes",
	"version": "1.0.1",
	"author": {
		"name": "depthbomb",
		"url": "https://github.com/depthbomb"
	},
	"description": "A pure TypeScript library for setting and reading file attributes on Windows",
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		"types": {
			"import": "./dist/index.d.mts",
			"require": "./dist/index.d.ts"
		},
		"import": "./dist/index.mjs",
		"require": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/depthbomb/windows-file-attributes.git"
	},
	"bugs": {
		"url": "https://github.com/depthbomb/windows-file-attributes/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"release": "yarn build && release-it"
	},
	"devDependencies": {
		"@types/eslint": "^9.6.1",
		"@types/node": "^22.18.1",
		"@typescript-eslint/eslint-plugin": "^8.42.0",
		"@typescript-eslint/parser": "^8.42.0",
		"eslint": "^9.34.0",
		"release-it": "^19.0.4",
		"terser": "^5.44.0",
		"tslib": "^2.8.1",
		"tsup": "^8.5.0",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"packageManager": "yarn@4.9.4"
}
